[Unit]
Description=Whisper ASR server (Spark's ears)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/whisper-moria
ExecStart=/opt/whisper-moria/build/bin/whisper-server -m /opt/whisper-moria/models/ggml-base.en.bin --host 0.0.0.0 --port 8399 --threads 16 -nt
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
